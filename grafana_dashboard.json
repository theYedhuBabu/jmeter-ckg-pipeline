          "rawSql": "SELECT\n    time,\n    sum(agent_threads) AS active_threads\nFROM\n(\n    SELECT\n        toStartOfInterval(timestamp, INTERVAL $__interval_s second) AS time,\n        agent_id,\n        max(all_threads) AS agent_threads\n    FROM metrics.jmeter_metrics\n    WHERE $__timeFilter(timestamp)\n    AND test_name = '${test_name}'\n    GROUP BY time, agent_id\n)\nGROUP BY time\nORDER BY time",
